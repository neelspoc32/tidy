<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/indexFragment">

    <fragment
        android:id="@+id/indexFragment"
        android:name="com.slavabarkov.tidy.fragments.IndexFragment"
        android:label="Tidy"
        tools:layout="@layout/fragment_index">
        <action
            android:id="@+id/action_indexFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.slavabarkov.tidy.fragments.SearchFragment"
        android:label="Search"
        tools:layout="@layout/fragment_search">
        <action
            android:id="@+id/action_searchFragment_to_indexFragment"
            app:destination="@id/indexFragment" />
        <action
            android:id="@+id/action_searchFragment_to_imageFragment"
            app:destination="@id/imageFragment" />
        <action
            android:id="@+id/action_searchFragment_to_fullScreenGalleryFragment"
            app:destination="@id/fullScreenGalleryFragment" />
    </fragment>

    <fragment
        android:id="@+id/imageFragment"
        android:name="com.slavabarkov.tidy.fragments.ImageFragment"
        android:label="Image"
        tools:layout="@layout/fragment_image">

        <argument
            android:name="internalId"
            app:argType="long" />
        <argument
            android:name="imageUriString"
            app:argType="string" />
        <action
            android:id="@+id/action_imageFragment_to_searchFragment"
            app:destination="@id/searchFragment"
            app:popUpTo="@id/searchFragment"
            app:popUpToInclusive="true" />
    </fragment>

